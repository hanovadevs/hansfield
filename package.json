{
  "name": "jenera",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/generation.test.ts tests/film.test.ts tests/security.test.ts tests/pricing.test.ts",
    "test:e2e": "playwright test",
    "models:sync": "node scripts/sync-model-schemas.mjs",
    "brand": "node scripts/build-brand-assets.mjs",
    "release:check": "pnpm check && pnpm test && pnpm test:e2e && pnpm build",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
