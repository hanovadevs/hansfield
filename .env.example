# Public launch uses each visitor's own verified API connection.
JENERA_APP_MODE=byok

# Set the public origin before the production build and at runtime.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this stable across restarts and instances. Never commit the actual value.
SESSION_ENCRYPTION_KEY=

# Higgsfield API endpoint
HF_API_BASE_URL=https://api.higgsfield.ai

# Persistent writable storage for per-key budgets and generation receipts.
# Defaults to ./data; mount /app/data when using the production container.
# JENERA_DATA_DIR=/absolute/path/to/jenera-data

# Optional local/private deployment only. Ignored in public BYOK mode.
# Set JENERA_APP_MODE=private only behind your own access control.
HF_API_KEY=
